<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.software.leanback" android:required="true" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:name=".SmartHealthTvApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="SmartHealth TV"
        android:logo="@drawable/banner_tv"
        android:banner="@drawable/banner_tv"
        android:theme="@style/Theme.SmartHealthTV">

        <!-- NUEVA ACTIVIDAD PRINCIPAL (COMPOSE) -->
        <activity
            android:name=".TVActivity"
            android:exported="true"
            android:label="SmartHealth TV (Compose)">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ACTIVIDAD ANTERIOR (LEANBACK) - Desactivada del Launcher -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="SmartHealth TV (Old)">
        </activity>
    </application>

</manifest>
